    {
      "parameters": {
        "jsCode": "const env = $json.body ?? $json;\nconst tipos = ['preflight', 'question', 'preview', 'blocked', 'done', 'progress'];\nif (!env || env.v !== 1) throw new Error('Envelope inválido: esperado v=1.');\nfor (const campo of ['message_id', 'demand_id', 'type', 'to', 'titulo', 'body_md', 'reply_to', 'rodada']) {\n  if (env[campo] === undefined || env[campo] === null) throw new Error(`Envelope inválido: campo ${campo} ausente.`);\n}\nlet rota;\nif (env.to !== 'team') rota = 6;\nelse if (!tipos.includes(env.type)) rota = 6;\nelse rota = ({ preflight: 0, question: 1, preview: 2, blocked: 3, done: 4, progress: 5 })[env.type];\nreturn [{ json: { ...env, rota } }];"
      },
      "id": "f1-validar",
      "name": "Validar envelope e destinatário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-900, 0]
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 7,
        "output": "={{ $json.rota }}"
      },
      "id": "f1-switch",
      "name": "Rotear por type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [-680, 0]
    },
    {
      "parameters": {
        "jsCode": "const e = $json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nfunction markdown(md) {\n  let s = esc(md);\n  s = s.replace(/^### (.+)$/gm, '<h3>$1</h3>').replace(/^## (.+)$/gm, '<h2>$1</h2>').replace(/^# (.+)$/gm, '<h1>$1</h1>');\n  s = s.replace(/\\*\\*(.+?)\\*\\*/g, '<strong>$1</strong>').replace(/`([^`]+)`/g, '<code>$1</code>');\n  s = s.replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^)]+)\\)/g, '<a href=\"$2\">$1</a>');\n  const linhas = s.split(/\\r?\\n/);\n  let html = '', lista = false;\n  for (const linha of linhas) {\n    const m = linha.match(/^[-*]\\s+(.+)$/);\n    if (m) { if (!lista) { html += '<ul>'; lista = true; } html += `<li>${m[1]}</li>`; continue; }\n    if (lista) { html += '</ul>'; lista = false; }\n    if (/^<h[1-3]>/.test(linha)) html += linha;\n    else if (linha.trim()) html += `<p>${linha}</p>`;\n  }\n  if (lista) html += '</ul>';\n  return html;\n}\nconst opcoes = Array.isArray(e.opcoes) && e.opcoes.length\n  ? `<p><strong>Opções:</strong></p><ul>${e.opcoes.map(o => `<li>${esc(o)}</li>`).join('')}</ul>` : '';\nconst padrao = e.default !== undefined && e.default !== null && String(e.default).trim()\n  ? `<p>Se ninguém responder, o agente segue com: <strong>${esc(e.default)}</strong></p>` : '';\nconst corte = `<p>--- responda acima desta linha ---<br>demanda #${esc(e.demand_id)} · rodada ${esc(e.rodada)} · ${esc(e.titulo_demanda)}</p>`;\nconst corpo_html = `${markdown(e.body_md)}${opcoes}${padrao}<br>${corte}`;\nconst assunto = `[esteira #${e.demand_id}-${e.rodada}] ${e.titulo}`;\nconst enviar_teams = ['question', 'preview', 'blocked', 'done'].includes(e.type);\nconst tem_anexos = e.type === 'preview' && Array.isArray(e.anexos) && e.anexos.length > 0;\nreturn [{ json: { ...e, assunto, corpo_html, enviar_teams, tem_anexos } }];"
      },

      "parameters": {
        "jsCode": "const anexos = $('Montar e-mail em HTML').first().json.anexos ?? [];\nreturn anexos.map((anexo, indice) => {\n  const caminho = typeof anexo === 'string' ? anexo : anexo.caminho;\n  if (!caminho) throw new Error(`Anexo ${indice + 1} sem caminho.`);\n  if (/^https?:\\/\\//i.test(caminho)) throw new Error('Anexo remoto não suportado nesta V1; use anexos[].caminho local no host do n8n.');\n  return { json: { caminho, nome: anexo.nome || '' } };\n});"
      },

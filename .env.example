# Copie para .env e ajuste. NÃO é lido por nenhum código Python:
#
#   - systemd:  EnvironmentFile=/caminho/esteira/.env
#   - na mão:   set -a; . ./.env; set +a
#
# Por isso todo valor com espaço vem ENTRE ASPAS. Sem aspas o systemd
# aceita, o bash não — e você perde meia hora achando que o CLI quebrou.

# === n8n ===
N8N_COMM_URL="http://localhost:5678/webhook/esteira-comm"
WORKER_BASE_URL="http://localhost:5000"

# === Board ===
BOARD_PORT="5000"
BOARD_SENHA=
DEBUG="true"

# === Limites ===
MAX_TURNOS="60"
TIMEOUT_RODADA_S="2700"
MAX_RODADAS="5"

# === Runtimes ===
# Confira com `runner.smoke_test(tier)` DEPOIS de mexer aqui. Flag de CLI
# muda sem avisar; é a fragilidade número um deste setup.

# claude: --verbose é obrigatório junto com --output-format stream-json.
# bypassPermissions: em -p, ferramenta não aprovada é NEGADA (não espera).
CMD_LEAD="claude -p --output-format stream-json --verbose --permission-mode bypassPermissions"

# codex: workspace-write deixa escrever no cwd; skip-git-repo-check porque
# workspace de demanda não é sempre repo git.
CMD_CODEX="codex exec -s workspace-write --skip-git-repo-check"

# opencode: --auto ou não escreve arquivo. -m é OBRIGATÓRIO — modelo free
# sai do ar sem aviso. Confira com `opencode models | grep -- -free`.
CMD_OPENCODE="opencode run --auto -m opencode/hy3-free"

# agy: o prompt é o VALOR de -p (stdin_prompt: false em config.py).
CMD_AGY="agy -p --dangerously-skip-permissions"

# orca: vazio de propósito. É ADE de desktop, não runtime headless.
CMD_ORCA=

# === Contas ===
POLITICA_CONTA="fixa"
CONTA_FIXA="nicolas"

# n8n
N8N_COMM_URL=http://localhost:5678/webhook/esteira-comm
WORKER_BASE_URL=http://localhost:5000

# Board
BOARD_PORT=5000
BOARD_SENHA=
DEBUG=true

# Limites
MAX_TURNOS=60
TIMEOUT_RODADA_S=2700
MAX_RODADAS=5

# Runtimes — ajuste ao que está instalado na máquina
CMD_LEAD=claude -p --output-format stream-json
CMD_CODEX=codex exec
CMD_OPENCODE=opencode run
CMD_AGY=
